# === Auth ===
AUTH_SECRET=your-secret-at-least-32-chars-long
# Публичный URL приложения (без слэша в конце). Обязателен для NextAuth и return_url ЮKassa.
# NEXTAUTH_URL=https://your-app.vercel.app
# Канонический домен для Open Graph, sitemap.xml и robots.txt (по умолчанию https://sensify.app)
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# === Admin ===
# Email админа (или несколько через запятую). Пусто = админка отключена
# ADMIN_EMAIL=admin@example.com

# === Database ===
# Локально: SQLite
DATABASE_URL="file:./dev.db"
# Turso (production): URL из консоли Turso + токен. Тогда Prisma идёт через LibSQL-адаптер.
# Оставьте DATABASE_URL=file для локалки; для migrate к облаку временно выставьте libsql URL в DATABASE_URL.
# TURSO_DATABASE_URL="libsql://your-db-org.turso.io"
# TURSO_AUTH_TOKEN="..."

# === Phase 0 Production (опционально) ===
# 32-byte ключ: hex (64 символа) или base64 → 32 bytes. Включает AES-256-GCM для groqApiKey/geminiApiKey в БД.
# ENCRYPTION_KEY=

# Upstash Redis — общий rate limit на нескольких инстансах (иначе in-memory)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# === Groq Cloud (рекомендуется — бесплатно, быстро, без установки) ===
# Получите ключ на https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=llama-3.1-8b-instant

# === Ollama (опционально — для полностью локальной работы) ===
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# === Notion (опционально) ===
# NOTION_API_KEY=

# === Sentry (error tracking, опционально) ===
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# === ЮKassa (для премиум-оплаты) ===
# Пошаговая настройка: docs/YOOKASSA_PAYMENTS.md
# Webhook в ЛК ЮKassa: POST https://<домен>/api/webhooks/yookassa (событие payment.succeeded)
# YOOKASSA_SHOP_ID=123456
# YOOKASSA_SECRET_KEY=live_xxx или test_xxx
# YOOKASSA_WEBHOOK_IP_CHECK=1 — проверка IP webhook (0 = только для отладки / ngrok)
